p = _dsl_ schema="../schema/lmhtml.dsl.json";
let pages = html.load_dir("tests/fixtures/site");
for (i in range(0, pages.len())) {
  let page = pages.at(i);
  let used = page.classes_used();
  let defined = page.css_classes();
  let missing = str_difference(used, defined);
  for (j in range(0, missing.len())) {
    let name = missing.at(j);
    let near = suggest(name, defined);
    let hint = "";
    if (near.len() > 0) { hint = " (did you mean " + near.at(0) + "?)"; }
    report.add("class-undefined", page.path(), 0, name + hint);
  }
  let unused = str_difference(defined, used);
  for (k in range(0, unused.len())) {
    report.add("class-unused", page.path(), 0, unused.at(k));
  }
  let ids_defined = page.css_ids();
  let ids_used = page.ids();
  let ids_unused = str_difference(ids_defined, ids_used);
  for (m in range(0, ids_unused.len())) {
    let name = ids_unused.at(m);
    let near = suggest(name, ids_used);
    let hint = "";
    if (near.len() > 0) { hint = " (did you mean " + near.at(0) + "?)"; }
    report.add("id-unused", page.path(), 0, name + hint);
  }
}
report.write_text("build/classes.txt");
report.write_json("build/classes.json");
end _dsl_
savedsl(p, "build/class-typos.dslb");
