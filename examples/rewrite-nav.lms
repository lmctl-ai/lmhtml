p = _dsl_ schema="../schema/lmhtml.dsl.json";
let pages = html.load_dir("tests/fixtures/tpl");
let nav_html = "<nav class=\"site-nav\"><a href=\"p1.html\">P1</a><a href=\"p2.html\">P2</a><a href=\"p3.html\">P3</a></nav>";
let footer_html = "<footer class=\"site-footer\"><span>Copyright</span><span>Legal</span></footer>";
for (i in range(0, pages.len())) {
  let page = pages.at(i);
  page.select("nav.site-nav").at(0).replace_with(nav_html);
  page.select("footer").at(0).replace_with(footer_html);
  html.save(page, "build/rewritten/p" + str(i) + ".html");
}
let first = html.load("build/rewritten/p0.html");
let n3 = html.diff(first, html.load("build/rewritten/p3.html"));
let n4 = html.diff(first, html.load("build/rewritten/p4.html"));
report.add("converged", "p0-vs-p3", 0, str(n3) + " differences after rewrite");
report.add("converged", "p0-vs-p4", 0, str(n4) + " differences after rewrite");
report.write_text("build/rewrite-report.txt");
end _dsl_
savedsl(p, "build/rewrite-nav.dslb");
