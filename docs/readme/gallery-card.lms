out = ARGV.len() > 0 ? ARGV[0] : "build/readme-gallery.dslb";
title = ARGV.len() > 1 ? ARGV[1] : "HTML REPORT";
report_path = ARGV.len() > 2 ? ARGV[2] : "build/links.txt";
image_path = ARGV.len() > 3 ? ARGV[3] : "build/rendered/readme-check-links.png";
source_lines = read_lines(report_path);
display_lines = [];
for (i in range(0, source_lines.len())) {
  let words = split(source_lines[i], " ");
  let current = "";
  for (j in range(0, words.len())) {
    let next = current == "" ? words[j] : current + " " + words[j];
    if (len(next) > 86 && current != "") {
      display_lines = push(display_lines, current);
      current = words[j];
    } else {
      current = next;
    }
  }
  if (current != "") { display_lines = push(display_lines, current); }
}
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(960, 540, "#101a23");
scene.rect(28.0, 28.0, 904.0, 484.0, "#182a38").set_attr("stroke", "#36505e").set_attr("stroke-width", "2");
scene.text(56.0, 78.0, 22.0, ${"LMHTML  /  " + title}, "#8bd8c8").set_attr("font-weight", "700");
scene.line(56.0, 102.0, 900.0, 102.0, "#36505e", 1.0);
scene.text(56.0, 148.0, 16.0, ${display_lines.get(0, "")}, "#e3ebef");
scene.text(56.0, 182.0, 16.0, ${display_lines.get(1, "")}, "#e3ebef");
scene.text(56.0, 216.0, 16.0, ${display_lines.get(2, "")}, "#e3ebef");
scene.text(56.0, 250.0, 16.0, ${display_lines.get(3, "")}, "#e3ebef");
scene.text(56.0, 284.0, 16.0, ${display_lines.get(4, "")}, "#e3ebef");
scene.text(56.0, 318.0, 16.0, ${display_lines.get(5, "")}, "#e3ebef");
scene.text(56.0, 352.0, 16.0, ${display_lines.get(6, "")}, "#e3ebef");
scene.text(56.0, 386.0, 16.0, ${display_lines.get(7, "")}, "#e3ebef");
scene.text(56.0, 420.0, 16.0, ${display_lines.get(8, "")}, "#e3ebef");
scene.text(56.0, 474.0, 13.0, "RELEASED LMHTML OUTPUT  ·  EXAMPLE SOURCE IN THIS REPOSITORY", "#9db2bc");
scene.render_png(${image_path}, 960, 540, 1);
end _dsl_
savedsl(p, out);
