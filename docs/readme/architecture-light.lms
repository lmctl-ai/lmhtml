out = ARGV.len() > 0 ? ARGV[0] : "build/readme-architecture-light.dslb";
p = _lmcode_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1400, 500, "#f4f3ee");
scene.text(64.0, 62.0, 27.0, "From source to a verified HTML change", "#142b39").set_attr("font-weight", "700");
scene.text(64.0, 96.0, 16.0, "The schema validates the task; the native host analyzes the actual pages.", "#536b76");

scene.rect(60.0, 212.0, 220.0, 132.0, "#e5eceb");
scene.rect(328.0, 212.0, 220.0, 132.0, "#e8eadf");
scene.rect(596.0, 212.0, 220.0, 132.0, "#e3eaf0");
scene.rect(864.0, 212.0, 220.0, 132.0, "#e4eee8");
scene.rect(1132.0, 212.0, 220.0, 132.0, "#f0e7dc");

scene.text(170.0, 258.0, 21.0, "LMScript source", "#142b39").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(170.0, 294.0, 14.0, "analysis task", "#536b76").set_attr("text-anchor", "middle");
scene.text(438.0, 258.0, 21.0, "Compiler", "#142b39").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(438.0, 294.0, 14.0, "checks against schema", "#536b76").set_attr("text-anchor", "middle");
scene.text(706.0, 258.0, 21.0, "DSL bytecode", "#142b39").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(706.0, 294.0, 14.0, "compiled task", "#536b76").set_attr("text-anchor", "middle");
scene.text(974.0, 258.0, 21.0, "lmhtml host", "#142b39").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(974.0, 294.0, 14.0, "embedded schema · native", "#536b76").set_attr("text-anchor", "middle");
scene.text(1242.0, 258.0, 20.0, "Reports + edits", "#142b39").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(1242.0, 294.0, 14.0, "findings · saved HTML", "#536b76").set_attr("text-anchor", "middle");

let a = scene.line(288.0, 278.0, 320.0, 278.0, "#24796f", 3.0); a.set_attr("marker-end", "arrow");
let b = scene.line(556.0, 278.0, 588.0, 278.0, "#24796f", 3.0); b.set_attr("marker-end", "arrow");
let c = scene.line(824.0, 278.0, 856.0, 278.0, "#24796f", 3.0); c.set_attr("marker-end", "arrow");
let d = scene.line(1092.0, 278.0, 1124.0, 278.0, "#24796f", 3.0); d.set_attr("marker-end", "arrow");

scene.rect(328.0, 142.0, 220.0, 42.0, "#cfe5de");
scene.text(438.0, 169.0, 15.0, "lmhtml schema", "#1d665e").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
let schema = scene.line(438.0, 187.0, 438.0, 204.0, "#24796f", 2.0); schema.set_attr("marker-end", "arrow");
scene.rect(864.0, 386.0, 220.0, 42.0, "#cfe5de");
scene.text(974.0, 413.0, 15.0, "HTML page files", "#1d665e").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
let pages = scene.line(974.0, 380.0, 974.0, 352.0, "#24796f", 2.0); pages.set_attr("marker-end", "arrow");
scene.text(64.0, 472.0, 15.0, "Compile once. Analyze real files. Save only the edits the script requests.", "#536b76");
scene.render_png("build/rendered/readme-architecture-light.png", 1400, 500, 1);
end _lmcode_
savedsl(p, out);
